.DS_Store
__pycache__/
*.py[cod]

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python 版本管理
.python-version
.tool-versions

# 内部调研文档（本地保留，不对外分发）
docs/research-*.md

# 开发/维护侧文档（AI 工作指引、项目背景与清理记录，正式分发不需要）
CLAUDE.md
BACKGROUND.md
AGENTS.md
RELOCATION.md

config/credentials.json
downloads/
test_downloads/

.pytest_cache/
.mypy_cache/

# 个人/团队敏感配置（分发时排除）
config/settings.json
config/permissions.json
config/risk_policy.json

# 运行时派生缓存
config/.token_cache.json

# 可选依赖环境
.venv/
venv/
.env

# 分发构建产物
dist/
build/
*.egg-info/
config/_auth_url.txt

# 用户自定义扩展（拉取上游更新时不被覆盖）
custom/*
!custom/.gitkeep
!custom/README.md
!custom/SKILL.md

# Claude Code 本地配置
.claude/

